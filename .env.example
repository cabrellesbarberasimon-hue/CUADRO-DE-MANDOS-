# Base de datos Postgres (Neon / Supabase / Vercel Postgres). Sin ella, en local se usa
# una base embebida en .data/ (PGlite). En producción es obligatoria.
DATABASE_URL=

# Secreto para firmar las sesiones (cadena aleatoria larga). Obligatorio en producción.
AUTH_SECRET=

# Código que se pide para crear el primer administrador en /setup. Obligatorio en producción.
SETUP_CODE=

# URL pública de la app (para enlaces en los emails)
APP_URL=https://cuadro-de-mandos-bocubi.vercel.app

# Emails (opcional): https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Cuadro de Mandos Bocubi <kpi@bocubi.com>"

# Resumen con IA (opcional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Protege las tareas programadas (Vercel lo envía automáticamente)
CRON_SECRET=
